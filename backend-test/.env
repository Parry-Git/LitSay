# ├── app/                          # 核心应用代码
# │   ├── __init__.py             # 应用工厂 (create_app)
# │   ├── auth/                   # 用户认证模块 (Blueprint)
# │   │   ├── __init__.py
# │   │   └── routes.py           # 认证相关API (register, login, etc.)
# │   ├── papers/                 # 文献管理模块 (Blueprint)
# │   │   ├── __init__.py
# │   │   └── routes.py           # 文献增删改查、搜索API
# │   ├── models/                 # 数据模型 (简单定义)
# │   │   ├── __init__.py
# │   │   └── user.py
# │   │   └── paper.py
# │   ├── services/               # 业务逻辑层 (可选，但推荐)
# │   │   ├── __init__.py
# │   │   ├── user_service.py
# │   │   └── paper_service.py
# │   ├── db.py                   # 数据库连接与操作模块
# │   ├── utils/                  # 工具类
# │   │   ├── __init__.py
# │   │   ├── decorators.py       # 例如：登录验证装饰器
# │   │   └── helpers.py          # 其他辅助函数
# │   └── config.py               # 配置文件
# ├── tests/                        # 测试目录
# │   ├── __init__.py
# │   ├── conftest.py             # Pytest 配置文件和 fixtures
# │   ├── data/                   # 测试用的SQL脚本或数据文件
# │   │   └── init_db.sql         # 数据库初始化脚本
# │   ├── test_auth.py            # 用户认证模块测试
# │   └── test_papers.py          # 文献模块测试
# ├── venv/                         # Python 虚拟环境 (推荐)
# ├── .env                          # 环境变量 (存储敏感信息)
# ├── .flaskenv                     # Flask CLI 环境变量
# ├── requirements.txt              # 项目依赖
# └── run.py                        # 项目启动脚本